<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>InfraVault</AssemblyName>
    <RootNamespace>InfraVault.Presentation</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Resources\infravault.ico')">Resources\infravault.ico</ApplicationIcon>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <!-- Précompilation : réduit nettement le temps de démarrage de la version livrée. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MsExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MsExtensionsVersion)" />
    <PackageReference Include="Serilog" Version="$(SerilogVersion)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InfraVault.Application\InfraVault.Application.csproj" />
    <ProjectReference Include="..\InfraVault.Infrastructure\InfraVault.Infrastructure.csproj" />
    <ProjectReference Include="..\InfraVault.Domain\InfraVault.Domain.csproj" />
    <ProjectReference Include="..\InfraVault.Shared\InfraVault.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\infravault.ico" Condition="Exists('Resources\infravault.ico')" />
  </ItemGroup>
</Project>
