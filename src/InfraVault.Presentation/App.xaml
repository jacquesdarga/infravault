<Application x:Class="InfraVault.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:InfraVault.Presentation.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 : thème, remplacé à chaud par ThemeService. -->
                <ResourceDictionary Source="Resources/Themes/Dark.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Views/Shared.xaml"/>
                <ResourceDictionary Source="Views/EntryViews.xaml"/>
                <ResourceDictionary Source="Views/ShellView.xaml"/>
                <ResourceDictionary Source="Views/DashboardView.xaml"/>
                <ResourceDictionary Source="Views/AssetViews.xaml"/>
                <ResourceDictionary Source="Views/CredentialViews.xaml"/>
                <ResourceDictionary Source="Views/DocumentViews.xaml"/>
                <ResourceDictionary Source="Views/OperationsViews.xaml"/>
                <ResourceDictionary Source="Views/SettingsView.xaml"/>
                <ResourceDictionary Source="Views/Dialogs.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
