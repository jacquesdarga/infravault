<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:InfraVault.Presentation.Controls"
                    xmlns:vm="clr-namespace:InfraVault.Presentation.ViewModels">

    <!-- ───────── Documentation ───────── -->
    <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
        <Grid Margin="32,26,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Procédures, configurations, notes" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Documentation" Style="{StaticResource H1}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Primary}" Command="{Binding NewCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding IsEditing, Converter={StaticResource Vis}, ConverterParameter=!}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="plus" Style="{StaticResource BtnIcon}"/>
                        <TextBlock Text="Nouveau document"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Mode lecture -->
            <Grid Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding IsEditing, Converter={StaticResource Vis}, ConverterParameter=!}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="244"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrer par titre ou tag"/>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" Margin="0,8,0,8"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Faint}">
                                            <Run Text="{Binding DocumentType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UpdatedAt, Mode=OneWay, Converter={StaticResource Date}, ConverterParameter=relative}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="16" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                            <c:IconView Kind="file" Width="30" Height="30" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Text="Aucun document" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}"
                                       Text="Rédigez vos procédures en Markdown, avec des blocs de commandes colorés. Le contenu est chiffré."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lecteur -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TextBlock Text="Sélectionnez un document." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Detail, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <Grid Visibility="{Binding Detail, Converter={StaticResource Vis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="24,18,16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Detail.Summary.Title}" Style="{StaticResource H2}" FontSize="19"/>
                                    <TextBlock Style="{StaticResource Faint}" Margin="0,3,0,0">
                                        <Run Text="{Binding Detail.Summary.DocumentType, Mode=OneWay}"/><Run Text="{Binding Detail.Summary.CurrentVersion, Mode=OneWay, StringFormat=' · version {0} · ', TargetNullValue=''}"/><Run Text="{Binding Detail.Summary.UpdatedAt, Mode=OneWay, Converter={StaticResource Date}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Command="{Binding EditCommand}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <c:IconView Kind="edit" Style="{StaticResource BtnIcon}"/>
                                            <TextBlock Text="Modifier"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" ToolTip="Supprimer">
                                        <c:IconView Kind="trash" Width="15" Height="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource WarnBanner}" Margin="24,0,24,12" Visibility="{Binding ViewingVersionLabel, Converter={StaticResource Vis}}">
                                <Grid>
                                    <TextBlock Text="{Binding ViewingVersionLabel}" VerticalAlignment="Center" Margin="0,0,150,0"/>
                                    <Button Style="{StaticResource Link}" Content="Revenir à la version courante" Command="{Binding BackToCurrentCommand}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <c:MarkdownViewer Markdown="{Binding ViewContent}" Margin="24,16,6,10"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Panneau latéral -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0" Visibility="{Binding Detail, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Ressources liées" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource Link}" Content="+ Lier" Command="{Binding LinkAssetCommand}" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Detail.Assets}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource RowButton}" Margin="-8,0,0,0" Padding="8,5"
                                                        Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:IconView Kind="{Binding Icon}" Tint="{Binding Color}" Width="15" Height="15" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Détacher"
                                                        Command="{Binding DataContext.UnlinkAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <c:IconView Kind="x" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Aucune ressource liée." Style="{StaticResource Faint}" Visibility="{Binding Detail.Assets.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource WrapItems}" Margin="0,12,0,-6" Focusable="False"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Kind="paperclip" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="Pièces jointes" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource Link}" Content="+ Joindre" Command="{Binding AddAttachmentCommand}" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Detail.Attachments}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileName}"/>
                                                    <TextBlock Text="{Binding SizeBytes, Converter={StaticResource Size}}" Style="{StaticResource Faint}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Déchiffrer et enregistrer"
                                                            Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:IconView Kind="download" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Supprimer"
                                                            Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:IconView Kind="trash" Width="13" Height="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Fichiers chiffrés dans le coffre (10 Mo max)." Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="{Binding Detail.Attachments.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Versions" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Detail.Versions}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="-8,0" Padding="8,5"
                                                    Command="{Binding DataContext.ViewVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <TextBlock>
                                                        <Run Text="{Binding VersionNumber, Mode=OneWay, StringFormat='v{0}', TargetNullValue=''}" FontFamily="{StaticResource Font.Mono}"/><Run Text="{Binding CreatedAt, Mode=OneWay, Converter={StaticResource Date}, StringFormat='   {0}', TargetNullValue=''}" Foreground="{DynamicResource TextMuted}"/>
                                                    </TextBlock>
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" HorizontalAlignment="Right" ToolTip="Version courante"
                                                             Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Mode édition -->
            <Grid Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Titre" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Tag="Procédure de restauration PostgreSQL" c:Assist.FocusOnLoad="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DocumentTypeNames}" SelectedItem="{Binding EditType}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="Tags (séparés par des virgules)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" Tag="sauvegarde, postgres"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource WarnBanner}" Margin="0,12,0,0" Visibility="{Binding LeakWarning, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="alert" Width="16" Height="16" Foreground="{DynamicResource Warning}" Margin="0,1,9,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{StaticResource Wrap}" MaxWidth="900"
                                   Text="Ce texte semble contenir un mot de passe, un jeton ou une clé privée. Enregistrez plutôt ce secret dans les identifiants et citez-le ici par son nom."/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Markdown" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                        <TextBox Grid.Row="1" Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Font.Mono}" FontSize="13" Padding="14,12"
                                 SpellCheck.IsEnabled="False"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Aperçu" Style="{StaticResource Overline}" Margin="2,0,0,6"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <c:MarkdownViewer Markdown="{Binding EditContent}" Margin="20,14,6,10"/>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Faint}" VerticalAlignment="Center"
                               Text="# Titre · **gras** · `code` · - liste · > citation · ```bash pour un bloc de commandes"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CancelEditCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Primary}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Kind="check" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Enregistrer"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ───────── Recherche ───────── -->
    <DataTemplate DataType="{x:Type vm:SearchViewModel}">
        <Grid Margin="32,26,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Recherche globale" Style="{StaticResource Overline}"/>
                <TextBlock Style="{StaticResource H1}" Margin="0,3,0,0">
                    <Run Text="Résultats pour « "/><Run Text="{Binding Query, Mode=OneWay}" Foreground="{DynamicResource Accent}"/><Run Text=" »"/>
                </TextBlock>
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding IncludeContent}" HorizontalAlignment="Right" Content="Chercher aussi dans le contenu des documents"
                              ToolTip="Le contenu est déchiffré en mémoire le temps de la recherche ; rien n'est écrit en clair sur le disque."/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,24" MaxWidth="980" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18" MinWidth="760">
                                    <TextBlock Style="{StaticResource Overline}" Margin="4,0,0,6">
                                        <Run Text="{Binding Category, Mode=OneWay}"/><Run Text="{Binding Hits.Count, Mode=OneWay, StringFormat='  ·  {0}', TargetNullValue=''}"/>
                                    </TextBlock>
                                    <Border Style="{StaticResource Card}" Padding="6">
                                        <ItemsControl ItemsSource="{Binding Hits}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <c:IconView Kind="{Binding Icon}" Tint="{Binding Color}" Margin="2,0,13,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Faint}" Visibility="{Binding Subtitle, Converter={StaticResource Vis}}"/>
                                                            </StackPanel>
                                                            <c:IconView Grid.Column="2" Kind="chevron-right" Width="14" Height="14" Foreground="{DynamicResource TextFaint}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding NoResult, Converter={StaticResource Vis}}" Margin="4,20,0,0">
                        <TextBlock Text="Aucun résultat." FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                   Text="La recherche porte sur les noms, hostnames, adresses IP, tags et propriétés non sensibles. Un username est retrouvé s'il est saisi en entier. Les secrets ne sont jamais indexés."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
