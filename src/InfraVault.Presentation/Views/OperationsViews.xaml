<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:InfraVault.Presentation.Controls"
                    xmlns:vm="clr-namespace:InfraVault.Presentation.ViewModels">

    <!-- ───────── Cartographie ───────── -->
    <DataTemplate DataType="{x:Type vm:TopologyViewModel}">
        <Grid Margin="32,26,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Vue globale" Style="{StaticResource Overline}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Cartographie" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Faint}" VerticalAlignment="Bottom" Margin="16,0,0,6"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Command="{Binding ExportPngCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsEmpty, Converter={StaticResource Not}}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Kind="image" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Exporter en PNG"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Primary}" Command="{Binding ExportDocxCommand}" IsEnabled="{Binding IsEmpty, Converter={StaticResource Not}}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Kind="file" Style="{StaticResource BtnIcon}"/>
                            <TextBlock Text="Dossier Word (.docx)"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Barre d'outils -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Pill}" Padding="11,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Kind="map" Width="13" Height="13" Margin="0,0,7,0" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding ScopeLabel}" FontWeight="SemiBold" MaxWidth="260"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Limiter à une ressource…" Command="{Binding PickScopeCommand}" Margin="0,0,8,0"/>
                    <Button Content="Tout afficher" Command="{Binding ClearScopeCommand}" Visibility="{Binding IsScoped, Converter={StaticResource Vis}}" Margin="0,0,8,0"/>
                    <CheckBox IsChecked="{Binding ShowPorts}" Content="Afficher les ports" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom arrière (Ctrl + molette)">
                        <TextBlock Text="−" FontSize="18" Margin="0,-3,0,0"/>
                    </Button>
                    <Button Content="Ajuster" Command="{Binding FitCommand}" Margin="0,0,8,0" ToolTip="Ajuster le schéma à la fenêtre"/>
                    <Button Style="{StaticResource Ghost}" Content="{Binding ZoomText}" Command="{Binding ZoomResetCommand}" MinWidth="58" ToolTip="Revenir à 100 %"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom avant (Ctrl + molette)">
                        <c:IconView Kind="plus" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Schéma -->
                <Border Style="{StaticResource Card}" Padding="0" Background="{DynamicResource Bg}" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <c:DiagramSurface Source="{Binding Diagram}" Width="{Binding DiagramWidth}" Height="{Binding DiagramHeight}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="Cliquez sur une ressource pour ouvrir sa fiche">
                                <c:DiagramSurface.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                </c:DiagramSurface.LayoutTransform>
                            </c:DiagramSurface>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" MaxWidth="460">
                            <c:IconView Kind="map" Width="36" Height="36" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Text="Rien à cartographier pour l'instant" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                            <TextBlock TextAlignment="Center" Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}"
                                       Text="Ajoutez des ressources, rattachez-les (un serveur héberge une VM, une stack contient des conteneurs) et décrivez leurs flux avec les ports : le schéma se construit tout seul."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Panneau : exposition et flux -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <c:IconView Kind="globe" Width="15" Height="15" Foreground="{DynamicResource Danger}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ouvert sur Internet" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Model.Exposures}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="-8,0" Padding="8,6"
                                                    Command="{Binding DataContext.OpenExposureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AssetName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PublicAddress}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextMuted}" FontSize="12"
                                                               Visibility="{Binding PublicAddress, Converter={StaticResource Vis}}"/>
                                                    <ItemsControl ItemsSource="{Binding Ports}" ItemTemplate="{StaticResource PortChip}" ItemsPanel="{StaticResource WrapItems}" Margin="0,5,0,-6" Focusable="False"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Aucune ressource n'est déclarée exposée." Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="{Binding Model.Exposures.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <c:IconView Kind="arrow-right" Width="15" Height="15" Foreground="{DynamicResource Teal}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Flux et ports" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Model.Flows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Margin="-8,0" Padding="8,6" ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.OpenFlowSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap" TextTrimming="None">
                                                        <Run Text="{Binding SourceName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Label, Mode=OneWay, StringFormat=' {0} ', TargetNullValue=''}" Foreground="{DynamicResource TextMuted}"/><Run Text="{Binding TargetName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Ports}" ItemTemplate="{StaticResource PortChip}" ItemsPanel="{StaticResource WrapItems}" Margin="0,5,0,-6" Focusable="False"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Aucun flux documenté. Ajoutez des relations depuis la fiche d'une ressource." Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None"
                                           Visibility="{Binding Model.Flows.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ───────── Audit ───────── -->
    <DataTemplate DataType="{x:Type vm:AuditViewModel}">
        <Grid Margin="32,26,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Journal scellé" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Audit" Style="{StaticResource H1}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Command="{Binding VerifyCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="shield-check" Style="{StaticResource BtnIcon}"/>
                        <TextBlock Text="Vérifier l'intégrité du journal"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="8" Padding="12,9" BorderThickness="1" Visibility="{Binding Verification, Converter={StaticResource Vis}}"
                    Background="{Binding Verification.IsValid, Converter={StaticResource State}, ConverterParameter=soft}"
                    BorderBrush="{Binding Verification.IsValid, Converter={StaticResource State}, ConverterParameter=brush}">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Kind="shield-check" Width="16" Height="16" Margin="0,0,9,0" Foreground="{Binding Verification.IsValid, Converter={StaticResource State}, ConverterParameter=brush}"/>
                    <TextBlock Text="{Binding Verification.Message}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" Width="280"/>
                    <CheckBox IsChecked="{Binding SecurityOnly}" Content="Sécurité uniquement" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <CheckBox IsChecked="{Binding FailuresOnly}" Content="Échecs uniquement" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8,22,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="N°" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="1" Text="Date" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="2" Text="Événement" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="3" Text="Objet" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="4" Text="Utilisateur" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="5" Text="Résultat" Style="{StaticResource Overline}"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" c:ItemClick.Command="{Binding OpenCommand}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Sequence}" Style="{StaticResource Mono}" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimestampUtc, Converter={StaticResource Date}}" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <c:IconView Kind="shield" Width="13" Height="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0" ToolTip="Événement de sécurité"
                                                    Visibility="{Binding IsSecurity, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding EventLabel}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3">
                                        <Run Text="{Binding Label, Mode=OneWay}"/><Run Text="{Binding Detail, Mode=OneWay, StringFormat='  {0}', TargetNullValue=''}" Foreground="{DynamicResource TextMuted}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{Binding UserName}" Foreground="{DynamicResource TextMuted}"/>
                                    <Border Grid.Column="5" Style="{StaticResource Pill}" HorizontalAlignment="Left" Background="{Binding Success, Converter={StaticResource State}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Success, Converter={StaticResource State}}" FontSize="11.5" Foreground="{Binding Success, Converter={StaticResource State}, ConverterParameter=brush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="Charger les événements plus anciens" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,8"
                            Visibility="{Binding CanLoadMore, Converter={StaticResource Vis}}"/>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ───────── Sauvegardes ───────── -->
    <DataTemplate DataType="{x:Type vm:BackupsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,26,32,32" MaxWidth="1180" HorizontalAlignment="Left">
                <Grid Margin="0,0,0,18" MinWidth="900">
                    <StackPanel>
                        <TextBlock Text="Sauvegarde et restauration" Style="{StaticResource Overline}"/>
                        <TextBlock Text="Sauvegardes" Style="{StaticResource H1}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Command="{Binding RestoreFileCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Kind="upload" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Restaurer depuis un fichier…"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Primary}" Command="{Binding BackupNowCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Kind="archive" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Sauvegarder maintenant"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dernière sauvegarde" Style="{StaticResource Faint}"/>
                            <TextBlock Text="{Binding LastBackup, Converter={StaticResource Date}}" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding AutoText}" Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0">
                            <TextBlock Text="Dossier des sauvegardes" Style="{StaticResource Faint}"/>
                            <TextBlock Text="{Binding Directory}" Style="{StaticResource Mono}" Margin="0,4,0,0" ToolTip="{Binding Directory}"/>
                            <TextBlock Style="{StaticResource Faint}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Choisissez de préférence un autre disque ou un support amovible : une sauvegarde sur le même disque ne protège pas d'une panne."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="Changer de dossier…" Command="{Binding ChangeDirectoryCommand}"/>
                            <Button Content="Ouvrir le dossier" Command="{Binding OpenFolderCommand}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Versions disponibles" Style="{StaticResource H2}" Margin="0,24,0,10"/>
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <c:IconView Kind="archive" Foreground="{DynamicResource Accent}" Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding CreatedAtUtc, Mode=OneWay, Converter={StaticResource Date}}"/><Run Text="{Binding VaultName, Mode=OneWay, StringFormat='   ·   {0}', TargetNullValue=''}" FontWeight="Normal" Foreground="{DynamicResource TextMuted}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Faint}">
                                                <Run Text="{Binding Assets, Mode=OneWay}"/><Run Text=" ressources · "/><Run Text="{Binding Credentials, Mode=OneWay}"/><Run Text=" identifiants · "/><Run Text="{Binding Documents, Mode=OneWay}"/><Run Text=" documents · "/><Run Text="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource Size}}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,14,0" Visibility="{Binding Automatic, Converter={StaticResource Vis}}">
                                            <TextBlock Text="Automatique" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="Vérifier" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Restaurer" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" ToolTip="Afficher dans l'Explorateur"
                                                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <c:IconView Kind="folder" Width="15" Height="15"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="14,16" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                            <TextBlock Text="Aucune sauvegarde dans ce dossier." FontWeight="SemiBold"/>
                            <TextBlock Text="Une sauvegarde est une archive chiffrée complète du coffre. Elle se restaure sur n'importe quel poste avec votre mot de passe maître."
                                       Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Exports et imports" Style="{StaticResource H2}" Margin="0,24,0,10"/>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <c:IconView Kind="server" Foreground="{DynamicResource Teal}" Margin="0,0,9,0"/>
                                <TextBlock Text="Ressources (JSON)" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}"
                                       Text="Inventaire et relations dans un fichier JSON lisible. Les propriétés sensibles et les secrets n'y figurent jamais."/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Exporter…" Command="{Binding ExportAssetsCommand}" Margin="0,0,8,0"/>
                                <Button Content="Importer…" Command="{Binding ImportAssetsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <c:IconView Kind="key" Foreground="{DynamicResource Accent}" Margin="0,0,9,0"/>
                                <TextBlock Text="Identifiants (chiffré uniquement)" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}"
                                       Text="Export protégé par une phrase de passe dédiée (Argon2id + AES-256-GCM). Aucun export de secrets en clair n'existe."/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Exporter…" Command="{Binding ExportSecretsCommand}" Margin="0,0,8,0"/>
                                <Button Content="Importer…" Command="{Binding ImportSecretsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
