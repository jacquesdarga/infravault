<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:InfraVault.Presentation.Controls"
                    xmlns:vm="clr-namespace:InfraVault.Presentation.ViewModels">

    <DataTemplate DataType="{x:Type vm:CredentialsViewModel}">
        <Grid Margin="32,26,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Coffre de secrets" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Identifiants" Style="{StaticResource H1}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource Primary}" Command="{Binding NewCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="plus" Style="{StaticResource BtnIcon}"/>
                        <TextBlock Text="Nouvel identifiant"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Liste -->
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrer par nom, adresse ou tag"/>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" Margin="0,8,0,8"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <c:IconView Kind="{Binding Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Faint}"/>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                                 Fill="{Binding Expiry, Converter={StaticResource State}, ConverterParameter=brush}"
                                                 ToolTip="{Binding Expiry, Converter={StaticResource State}}"
                                                 Visibility="{Binding ExpiresAt, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="16" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                            <c:IconView Kind="key" Width="30" Height="30" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Text="Aucun identifiant" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}"
                                       Text="Mots de passe, clés SSH, jetons d'API : chaque secret est chiffré et son historique conservé."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fiche -->
                <Grid Grid.Column="1">
                    <TextBlock Text="Sélectionnez un identifiant pour afficher sa fiche." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Detail, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Detail, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                                            <c:IconView Kind="{Binding Detail.Summary.Icon}" Width="22" Height="22" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Detail.Summary.Name}" Style="{StaticResource H2}" FontSize="20"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Detail.Summary.TypeLabel}" Style="{StaticResource Muted}"/>
                                                <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{Binding Detail.Summary.Expiry, Converter={StaticResource State}, ConverterParameter=soft}">
                                                    <TextBlock FontSize="11.5" Foreground="{Binding Detail.Summary.Expiry, Converter={StaticResource State}, ConverterParameter=brush}">
                                                        <Run Text="{Binding Detail.Summary.Expiry, Mode=OneWay, Converter={StaticResource State}}"/><Run Text="{Binding Detail.Summary.ExpiresAt, Mode=OneWay, Converter={StaticResource Date}, ConverterParameter=date, StringFormat=' · {0}', TargetNullValue=''}"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding EditCommand}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:IconView Kind="edit" Style="{StaticResource BtnIcon}"/>
                                                    <TextBlock Text="Modifier"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" ToolTip="Supprimer">
                                                <c:IconView Kind="trash" Width="15" Height="15"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Username -->
                                    <StackPanel Visibility="{Binding Detail.Summary.HasUsername, Converter={StaticResource Vis}}" Margin="0,0,0,14">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,4,4,4">
                                            <Grid>
                                                <TextBlock Text="{Binding UsernameText}" Style="{StaticResource Mono}" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,80,0"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleUsernameCommand}" ToolTip="Afficher / masquer">
                                                        <Grid>
                                                            <c:IconView Kind="eye" Width="16" Height="16" Visibility="{Binding IsUsernameVisible, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                                            <c:IconView Kind="eye-off" Width="16" Height="16" Visibility="{Binding IsUsernameVisible, Converter={StaticResource Vis}}"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding CopyUsernameCommand}" ToolTip="Copier le username">
                                                        <c:IconView Kind="copy" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Secret -->
                                    <TextBlock Text="Secret" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,4,4,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBox Text="{Binding SecretText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,5"
                                                     FontFamily="{StaticResource Font.Mono}" FontSize="13.5" Margin="0,0,84,0" TextWrapping="Wrap" MaxHeight="150"
                                                     VerticalScrollBarVisibility="Auto" MinHeight="0"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSecretCommand}" ToolTip="Afficher / masquer le secret (journalisé)">
                                                    <Grid>
                                                        <c:IconView Kind="eye" Width="16" Height="16" Visibility="{Binding IsSecretVisible, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                                        <c:IconView Kind="eye-off" Width="16" Height="16" Visibility="{Binding IsSecretVisible, Converter={StaticResource Vis}}"/>
                                                    </Grid>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Command="{Binding CopySecretCommand}" ToolTip="Copier le secret (journalisé)">
                                                    <c:IconView Kind="copy" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,2,8,5" Visibility="{Binding IsSecretVisible, Converter={StaticResource Vis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Minimum="0" Maximum="{Binding RevealTotal}" Value="{Binding RevealRemaining}" VerticalAlignment="Center" Height="3"/>
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Faint}">
                                                    <Run Text="masqué dans "/><Run Text="{Binding RevealRemaining, Mode=OneWay}"/><Run Text=" s"/>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Style="{StaticResource Faint}" Margin="2,7,0,0" TextWrapping="Wrap" TextTrimming="None"
                                               Text="La copie demande à Windows d'exclure le secret de l'historique du presse-papiers, puis l'efface automatiquement. Un gestionnaire de presse-papiers tiers peut toutefois en garder une copie."/>

                                    <!-- Adresse -->
                                    <Grid Margin="0,16,0,0" Visibility="{Binding Detail.Summary.Url, Converter={StaticResource Vis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Adresse / endpoint" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                            <TextBlock Style="{StaticResource Mono}" FontSize="13">
                                                <Run Text="{Binding Detail.Summary.Url, Mode=OneWay}"/><Run Text="{Binding Detail.Summary.Port, Mode=OneWay, StringFormat=' : {0}', TargetNullValue=''}" Foreground="{DynamicResource Teal}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding CopyUrlCommand}" ToolTip="Copier l'adresse">
                                            <c:IconView Kind="copy" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChip}" ItemsPanel="{StaticResource WrapItems}" Margin="0,16,0,-6" Focusable="False"/>

                                    <!-- Notes chiffrées -->
                                    <StackPanel Visibility="{Binding Detail.HasNotes, Converter={StaticResource Vis}}" Margin="0,16,0,0">
                                        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <c:IconView Kind="lock" Width="13" Height="13" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/>
                                                <TextBlock Text="Notes chiffrées" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource Link}" Content="Afficher / masquer" Command="{Binding ToggleNotesCommand}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding NotesText}" Style="{StaticResource Wrap}" Margin="0,8,0,0" Visibility="{Binding NotesText, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ressources associées -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Ressources associées" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <Button Style="{StaticResource Link}" Content="+ Associer une ressource" Command="{Binding LinkAssetCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Detail.Assets}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource RowButton}" Margin="-10,0,0,0"
                                                            Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AssetRow}"/>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Détacher"
                                                            Command="{Binding DataContext.UnlinkAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <c:IconView Kind="x" Width="14" Height="14"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Cet identifiant n'est rattaché à aucune ressource." Style="{StaticResource Muted}"
                                               Visibility="{Binding Detail.Assets.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                </StackPanel>
                            </Border>

                            <!-- Historique des versions -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Historique des versions" Style="{StaticResource CardTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Detail.Versions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding VersionNumber, StringFormat='v{0}', TargetNullValue=''}" FontFamily="{StaticResource Font.Mono}" FontSize="12"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt, Converter={StaticResource Date}}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ChangeReason}" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="3">
                                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoft}" Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="Version courante" FontSize="11.5" Foreground="{DynamicResource Success}"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCurrent, Converter={StaticResource Vis}, ConverterParameter=!}">
                                                            <Button Style="{StaticResource Ghost}" Content="Voir" MinHeight="26"
                                                                    Command="{Binding DataContext.ViewVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource Ghost}" Content="Restaurer" MinHeight="26"
                                                                    Command="{Binding DataContext.RestoreVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Faint}" Margin="0,10,0,0">
                                        <Run Text="Créé le "/><Run Text="{Binding Detail.CreatedAt, Mode=OneWay, Converter={StaticResource Date}}"/><Run Text=" · les anciennes versions restent chiffrées."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
