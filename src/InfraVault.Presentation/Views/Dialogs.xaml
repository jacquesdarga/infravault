<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:InfraVault.Presentation.Controls"
                    xmlns:vm="clr-namespace:InfraVault.Presentation.ViewModels">

    <!-- Pied de dialogue standard -->
    <Style x:Key="DialogFooter" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,20,0,0"/>
    </Style>

    <!-- ───────── Confirmation ───────── -->
    <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}" LineHeight="20"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True" c:Assist.FocusOnLoad="True"/>
                <Button Style="{StaticResource Primary}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                        Visibility="{Binding IsDanger, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                <Button Style="{StaticResource DangerButton}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                        Visibility="{Binding IsDanger, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Saisie simple ───────── -->
    <DataTemplate DataType="{x:Type vm:PromptDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"
                       Visibility="{Binding Hint, Converter={StaticResource Vis}}"/>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" c:Assist.FocusOnLoad="True" c:Assist.EnterCommand="{Binding ConfirmCommand}"
                     Visibility="{Binding IsPassword, Converter={StaticResource Vis}, ConverterParameter=!}"/>
            <PasswordBox c:Assist.BindPassword="True" c:Assist.Password="{Binding Value, UpdateSourceTrigger=PropertyChanged}" c:Assist.FocusOnLoad="True"
                         c:Assist.EnterCommand="{Binding ConfirmCommand}" Visibility="{Binding IsPassword, Converter={StaticResource Vis}}"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Sélecteur ───────── -->
    <DataTemplate DataType="{x:Type vm:PickerDialogViewModel}">
        <StackPanel>
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrer…" c:Assist.FocusOnLoad="True"
                     Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=!}"/>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Height="340" Margin="0,10,0,0" c:ItemClick.Command="{Binding PickCommand}"
                     Visibility="{Binding IsEmpty, Converter={StaticResource Vis}, ConverterParameter=!}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Kind="{Binding Icon}" Tint="{Binding Color}" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Faint}" Visibility="{Binding Subtitle, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="0,10" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Fermer" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Clé de récupération ───────── -->
    <DataTemplate DataType="{x:Type vm:RecoveryKeyDialogViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}" LineHeight="20"
                       Text="Cette clé est le seul moyen de rouvrir le coffre si vous oubliez votre mot de passe maître. Elle n'est affichée qu'une fois. Conservez-la hors de ce poste : impression, coffre physique, clé USB chiffrée."/>
            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,16,0,0">
                <TextBox Text="{Binding RecoveryKey, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextAlignment="Center" TextWrapping="Wrap"
                         FontFamily="{StaticResource Font.Mono}" FontSize="19" Foreground="{DynamicResource Accent}" Padding="0" MinHeight="0"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Command="{Binding CopyCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="copy" Style="{StaticResource BtnIcon}"/>
                        <TextBlock Text="Copier"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Kind="download" Style="{StaticResource BtnIcon}"/>
                        <TextBlock Text="Enregistrer dans un fichier…"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Style="{StaticResource WarnBanner}" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource Wrap}" Text="Sans mot de passe maître ni clé de récupération, les données du coffre sont définitivement inaccessibles. Personne ne peut les récupérer."/>
            </Border>
            <CheckBox IsChecked="{Binding Acknowledged}" Margin="0,16,0,0" Content="J'ai conservé ma clé de récupération en lieu sûr"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Style="{StaticResource Primary}" Content="Terminer" Command="{Binding DoneCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Affichage temporaire d'un secret ───────── -->
    <DataTemplate DataType="{x:Type vm:SecretViewDialogViewModel}">
        <StackPanel>
            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <TextBox Text="{Binding Secret, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" MaxHeight="220"
                         FontFamily="{StaticResource Font.Mono}" FontSize="14" Padding="0" MinHeight="0" VerticalScrollBarVisibility="Auto"/>
            </Border>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Remaining}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Faint}">
                    <Run Text="fermeture dans "/><Run Text="{Binding Remaining, Mode=OneWay}"/><Run Text=" s"/>
                </TextBlock>
            </Grid>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Copier" Command="{Binding CopyCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Fermer" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Restauration : secret de la sauvegarde ───────── -->
    <DataTemplate DataType="{x:Type vm:RestoreDialogViewModel}">
        <StackPanel>
            <ContentControl Focusable="False" Content="{Binding Error}" ContentTemplate="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <c:IconView Kind="archive" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding FileName}" Style="{StaticResource Mono}" VerticalAlignment="Center" MaxWidth="400"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Wrap}" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"
                       Text="Saisissez le mot de passe maître qui était en vigueur lorsque cette sauvegarde a été créée."/>
            <TextBlock Text="Mot de passe maître de la sauvegarde" Style="{StaticResource FieldLabel}" Visibility="{Binding UseRecoveryKey, Converter={StaticResource Vis}, ConverterParameter=!}"/>
            <PasswordBox c:Assist.BindPassword="True" c:Assist.Password="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" c:Assist.FocusOnLoad="True"
                         c:Assist.EnterCommand="{Binding ConfirmCommand}" Visibility="{Binding UseRecoveryKey, Converter={StaticResource Vis}, ConverterParameter=!}"/>
            <TextBlock Text="Clé de récupération de la sauvegarde" Style="{StaticResource FieldLabel}" Visibility="{Binding UseRecoveryKey, Converter={StaticResource Vis}}"/>
            <TextBox Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" CharacterCasing="Upper"
                     Visibility="{Binding UseRecoveryKey, Converter={StaticResource Vis}}"/>
            <CheckBox IsChecked="{Binding UseRecoveryKey}" Content="Utiliser la clé de récupération à la place" Margin="0,12,0,0"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Continuer" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Changement de mot de passe maître ───────── -->
    <DataTemplate DataType="{x:Type vm:ChangePasswordDialogViewModel}">
        <StackPanel>
            <ContentControl Focusable="False" Content="{Binding Error}" ContentTemplate="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
            <TextBlock Text="Mot de passe maître actuel" Style="{StaticResource FieldLabel}"/>
            <PasswordBox c:Assist.BindPassword="True" c:Assist.Password="{Binding Current, UpdateSourceTrigger=PropertyChanged}" c:Assist.FocusOnLoad="True"/>
            <TextBlock Text="Nouveau mot de passe maître (12 caractères minimum)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <PasswordBox c:Assist.BindPassword="True" c:Assist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StrengthMeter}"/>
            <TextBlock Text="Confirmer le nouveau mot de passe" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <PasswordBox c:Assist.BindPassword="True" c:Assist.Password="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" c:Assist.EnterCommand="{Binding SaveCommand}"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Changer le mot de passe" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Relation ───────── -->
    <DataTemplate DataType="{x:Type vm:RelationshipDialogViewModel}">
        <StackPanel>
            <ContentControl Focusable="False" Content="{Binding Error}" ContentTemplate="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cette ressource" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="7" Padding="11,8">
                        <TextBlock Text="{Binding AssetName}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Relation" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Ressource reliée" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="11,7" MinHeight="34">
                    <Grid>
                        <TextBlock Text="Aucune ressource choisie" Style="{StaticResource Faint}" VerticalAlignment="Center" Visibility="{Binding Other, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Other, Converter={StaticResource Vis}}">
                            <c:IconView Kind="{Binding Other.Icon}" Tint="{Binding Other.Color}" Width="16" Height="16" Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding Other.Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Grid.Column="1" Content="Choisir…" Command="{Binding PickOtherCommand}" Margin="8,0,0,0" c:Assist.FocusOnLoad="True"/>
            </Grid>
            <TextBlock Text="Ports et protocoles (facultatif)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <TextBox Text="{Binding Ports, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="5432/tcp, 443"/>
            <TextBlock Text="{Binding PortsHint}" Style="{StaticResource Faint}" Margin="0,5,0,0"/>
            <TextBlock Text="Description (facultatif)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Tag="Base applicative, réplication, NAT entrant…"/>
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Créer la relation" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ───────── Éditeur de ressource ───────── -->
    <DataTemplate DataType="{x:Type vm:AssetEditorDialogViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="590" Padding="0,0,12,0">
                <StackPanel>
                    <ContentControl Focusable="False" Content="{Binding Error}" ContentTemplate="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>

                    <!-- Identité + icône -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource RowButton}" Padding="0" Command="{Binding ToggleIconPickerCommand}" ToolTip="Personnaliser l'icône" VerticalAlignment="Bottom">
                            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                <c:IconView Kind="{Binding Icon}" Tint="{Binding Color}" Width="28" Height="28"/>
                            </Border>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Proxmox Node 01" c:Assist.FocusOnLoad="True" MaxLength="120"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sélecteur d'icône -->
                    <Border Style="{StaticResource Card}" Background="{DynamicResource BgDeep}" Padding="16" Margin="0,12,0,0" Visibility="{Binding IsIconPickerOpen, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Personnaliser l'icône" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoft}" Margin="10,0,0,0" Visibility="{Binding IsIconCustom, Converter={StaticResource Vis}}">
                                        <TextBlock Text="Personnalisé" FontSize="11.5" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <Button Style="{StaticResource Link}" Content="Revenir à l'icône de la catégorie" Command="{Binding ResetIconCommand}" HorizontalAlignment="Right"
                                        Visibility="{Binding IsIconCustom, Converter={StaticResource Vis}}"/>
                            </Grid>
                            <TextBlock Text="Catégories" Style="{StaticResource Overline}" Margin="0,0,0,7"/>
                            <ItemsControl ItemsSource="{Binding IconCategories}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ButtonBase}" Margin="0,0,7,7" MinHeight="54" Background="{DynamicResource Surface}"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <StackPanel>
                                                <c:IconView Kind="{Binding Icon}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Overline}" Margin="0,8,0,7">
                                <Run Text="Icônes — "/><Run Text="{Binding SelectedCategory.Name, Mode=OneWay}"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SelectedCategory.Icons}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ButtonBase}" Width="44" Height="44" Padding="0" Margin="0,0,7,7" Background="{DynamicResource Surface}" ToolTip="{Binding}"
                                                Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <c:IconView Kind="{Binding}" Width="21" Height="21" Tint="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Couleur" Style="{StaticResource Overline}" Margin="0,8,0,7"/>
                            <ItemsControl ItemsSource="{Binding Colors}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}" Padding="3" Margin="0,0,6,0" ToolTip="{Binding}"
                                                Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <Ellipse Width="26" Height="26" c:Tinted.Background="{Binding}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Réseau, environnement -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Hostname" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="pve-node01"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Adresse IP" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="10.52.134.11"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Environnement" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0">
                            <TextBlock Text="Statut" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,0">
                            <TextBlock Text="Tags" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Tag="prod, réseau"/>
                        </StackPanel>
                    </Grid>

                    <!-- Rattachement (création) -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsNew, Converter={StaticResource Vis}}">
                        <TextBlock Text="Rattachée à (facultatif)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="7" Padding="11,7" MinHeight="34">
                                <Grid>
                                    <TextBlock Text="Aucun parent : la ressource sera à la racine" Style="{StaticResource Faint}" VerticalAlignment="Center"
                                               Visibility="{Binding Parent, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Parent, Converter={StaticResource Vis}}">
                                        <c:IconView Kind="{Binding Parent.Icon}" Tint="{Binding Parent.Color}" Width="16" Height="16" Margin="0,0,9,0"/>
                                        <TextBlock Text="{Binding Parent.Title}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                                <Button Content="Choisir…" Command="{Binding PickParentCommand}"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding ClearParentCommand}" ToolTip="Retirer le parent" Visibility="{Binding Parent, Converter={StaticResource Vis}}">
                                    <c:IconView Kind="x" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding RelationOptions}" SelectedItem="{Binding ParentRelation}" IsEnabled="{Binding Parent, Converter={StaticResource Vis}, ConverterParameter=bool}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Exposition Internet -->
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="9" Padding="14,11" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InternetExposed}">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Kind="globe" Width="16" Height="16" Margin="0,0,9,0" Foreground="{DynamicResource Danger}"/>
                                    <TextBlock Text="Cette ressource est joignable depuis Internet"/>
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,12,0,0" Visibility="{Binding InternetExposed, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0">
                                    <TextBlock Text="Adresse publique (IP ou domaine)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding PublicAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="portail.exemple.org"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Ports ouverts" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ExposedPorts, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="443/tcp, 80/tcp"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Champs propres à la catégorie -->
                    <TextBlock Style="{StaticResource Overline}" Margin="0,20,0,8" Visibility="{Binding Fields.Count, Converter={StaticResource Vis}}">
                        <Run Text="Propriétés — "/><Run Text="{Binding SelectedType.Name, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,10,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        <c:IconView Kind="lock" Width="11" Height="11" Foreground="{DynamicResource Accent}" Margin="6,0,0,0" ToolTip="Champ chiffré"
                                                    Visibility="{Binding IsSensitive, Converter={StaticResource Vis}}"/>
                                        <Button Style="{StaticResource Link}" Content="effacer" FontSize="11.5" Margin="8,0,0,0" Command="{Binding ClearCommand}"
                                                Visibility="{Binding HasStoredSecret, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Placeholder}" Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Placeholder}" Style="{StaticResource Multiline}"
                                             Visibility="{Binding IsMultiline, Converter={StaticResource Vis}}"/>
                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" Visibility="{Binding IsChoice, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,6,0,5"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Multiline}" Tag="Rôle de la ressource, particularités…"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Enregistrer" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ───────── Éditeur d'identifiant ───────── -->
    <DataTemplate DataType="{x:Type vm:CredentialEditorDialogViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="590" Padding="0,0,12,0">
                <StackPanel>
                    <ContentControl Focusable="False" Content="{Binding Error}" ContentTemplate="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="PostgreSQL — superutilisateur" c:Assist.FocusOnLoad="True" MaxLength="120"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="root"/>

                    <!-- Secret -->
                    <Grid Margin="0,14,0,5">
                        <TextBlock Text="{Binding SecretLabel}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <Button Style="{StaticResource Link}" Command="{Binding ToggleGeneratorCommand}" HorizontalAlignment="Right" Content="Générateur de mots de passe"
                                Visibility="{Binding IsMultilineSecret, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                    </Grid>
                    <Grid Visibility="{Binding IsMultilineSecret, Converter={StaticResource Vis}, ConverterParameter=!}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox c:Assist.BindPassword="True" c:Assist.Password="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                                     Visibility="{Binding ShowSecret, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                        <TextBox Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Visibility="{Binding ShowSecret, Converter={StaticResource Vis}}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Style="{StaticResource IconButton}" Command="{Binding ToggleShowCommand}" ToolTip="Afficher / masquer">
                                <c:IconView Kind="eye" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding GenerateCommand}" ToolTip="Générer un mot de passe aléatoire">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Kind="wand" Style="{StaticResource BtnIcon}"/>
                                    <TextBlock Text="Générer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" Height="130" VerticalContentAlignment="Top"
                             FontFamily="{StaticResource Font.Mono}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Tag="-----BEGIN OPENSSH PRIVATE KEY-----" Visibility="{Binding IsMultilineSecret, Converter={StaticResource Vis}}"/>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StrengthMeter}" Visibility="{Binding IsMultilineSecret, Converter={StaticResource Vis}, ConverterParameter=!}"/>

                    <!-- Générateur -->
                    <Border Style="{StaticResource Card}" Background="{DynamicResource BgDeep}" Padding="16" Margin="0,12,0,0" Visibility="{Binding IsGeneratorOpen, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Générateur" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EntropyText}" Style="{StaticResource Faint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Longueur" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Slider Grid.Column="1" Minimum="8" Maximum="64" Value="{Binding Length}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Grid.Column="2" Text="{Binding Length}" FontFamily="{StaticResource Font.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <CheckBox IsChecked="{Binding UseLower}" Content="Minuscules (a-z)" Margin="0,0,22,8"/>
                                <CheckBox IsChecked="{Binding UseUpper}" Content="Majuscules (A-Z)" Margin="0,0,22,8"/>
                                <CheckBox IsChecked="{Binding UseDigits}" Content="Chiffres (0-9)" Margin="0,0,22,8"/>
                                <CheckBox IsChecked="{Binding UseSymbols}" Content="Caractères spéciaux" Margin="0,0,22,8"/>
                                <CheckBox IsChecked="{Binding ExcludeAmbiguous}" Content="Exclure les caractères ambigus (0 O 1 l I…)" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="Tirage par le générateur aléatoire cryptographique du système." Style="{StaticResource Faint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Motif de modification -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding SecretChanged, Converter={StaticResource Vis}}">
                        <TextBlock Text="Motif du changement (conservé dans l'historique des versions)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ChangeReason, UpdateSourceTrigger=PropertyChanged}" Tag="Rotation du mot de passe"/>
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="URL ou endpoint" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="db-srv.exemple.local"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="5432"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Expiration (facultatif)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ExpiresOn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoBox}" Tag="AAAA-MM-JJ"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Ghost}" Content="+90 j" MinHeight="24" Padding="7,0" Command="{Binding SetExpiryCommand}" CommandParameter="90"/>
                                <Button Style="{StaticResource Ghost}" Content="+6 mois" MinHeight="24" Padding="7,0" Command="{Binding SetExpiryCommand}" CommandParameter="182"/>
                                <Button Style="{StaticResource Ghost}" Content="+1 an" MinHeight="24" Padding="7,0" Command="{Binding SetExpiryCommand}" CommandParameter="365"/>
                                <Button Style="{StaticResource Ghost}" Content="aucune" MinHeight="24" Padding="7,0" Command="{Binding SetExpiryCommand}" CommandParameter="0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Tags" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Tag="ssh, prod"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ressources -->
                    <Grid Margin="0,16,0,6">
                        <TextBlock Text="Ressources associées" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <Button Style="{StaticResource Link}" Content="+ Associer une ressource" Command="{Binding AddAssetCommand}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Assets}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Pill}" Padding="9,4,4,4" Margin="0,0,7,7">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Kind="{Binding Icon}" Tint="{Binding Color}" Width="14" Height="14" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="5,0,0,0" ToolTip="Retirer"
                                                Command="{Binding DataContext.RemoveAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <c:IconView Kind="x" Width="11" Height="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Un même identifiant peut être associé à plusieurs ressources." Style="{StaticResource Faint}"
                               Visibility="{Binding Assets.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,5">
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <c:IconView Kind="lock" Width="11" Height="11" Foreground="{DynamicResource Accent}" Margin="6,0,0,0" ToolTip="Notes chiffrées"/>
                    </StackPanel>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Multiline}" Tag="Notes chiffrées avec le secret"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Enregistrer" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ───────── Éditeur de catégorie ───────── -->
    <DataTemplate DataType="{x:Type vm:AssetTypeDialogViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="590" Padding="0,0,12,0">
                <StackPanel>
                    <ContentControl Focusable="False" Content="{Binding Error}" ContentTemplate="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" VerticalAlignment="Bottom">
                            <c:IconView Kind="{Binding Icon}" Tint="{Binding Color}" Width="28" Height="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Nom de la catégorie" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Onduleur" MaxLength="60" c:Assist.FocusOnLoad="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Icône" Style="{StaticResource Overline}" Margin="0,16,0,7"/>
                    <ItemsControl ItemsSource="{Binding AllIcons}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ButtonBase}" Width="38" Height="38" Padding="0" Margin="0,0,6,6" ToolTip="{Binding}"
                                        Command="{Binding DataContext.SelectIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <c:IconView Kind="{Binding}" Width="18" Height="18"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Couleur" Style="{StaticResource Overline}" Margin="0,8,0,7"/>
                    <ItemsControl ItemsSource="{Binding Colors}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Padding="3" Margin="0,0,6,0" ToolTip="{Binding}"
                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Ellipse Width="26" Height="26" c:Tinted.Background="{Binding}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,20,0,8">
                        <StackPanel>
                            <TextBlock Text="Champs" Style="{StaticResource Overline}"/>
                            <TextBlock Text="Un champ sensible est chiffré et masqué par défaut." Style="{StaticResource Faint}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding AddFieldCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Kind="plus" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Ajouter un champ"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Tag="Libellé" IsReadOnly="{Binding IsLocked}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Tag="Groupe" Margin="6,0,0,0" IsReadOnly="{Binding IsLocked}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="6,0,0,0" IsEnabled="{Binding IsLocked, Converter={StaticResource Not}}"/>
                                    <TextBox Grid.Column="3" Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}" Tag="Choix : a, b, c" Margin="6,0,0,0" IsReadOnly="{Binding IsLocked}"/>
                                    <CheckBox Grid.Column="4" IsChecked="{Binding IsSensitive}" Content="Sensible" Margin="10,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsLocked, Converter={StaticResource Not}}"/>
                                    <Grid Grid.Column="5" Width="34" Margin="4,0,0,0">
                                        <Button Style="{StaticResource IconButton}" ToolTip="Retirer ce champ" Visibility="{Binding IsLocked, Converter={StaticResource Vis}, ConverterParameter=!}"
                                                Command="{Binding DataContext.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <c:IconView Kind="x" Width="14" Height="14"/>
                                        </Button>
                                        <c:IconView Kind="lock" Width="13" Height="13" Foreground="{DynamicResource TextFaint}" ToolTip="Champ d'origine de la catégorie système"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource Vis}}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucun champ spécifique : la ressource n'aura que les champs communs (nom, hostname, IP…)." Style="{StaticResource Faint}"
                               Visibility="{Binding Fields.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Style="{StaticResource DialogFooter}">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Primary}" Content="Enregistrer" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
