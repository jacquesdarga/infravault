<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:InfraVault.Presentation.Controls"
                    xmlns:vm="clr-namespace:InfraVault.Presentation.ViewModels">

    <HierarchicalDataTemplate x:Key="TreeNodeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Node.Name}">
            <c:IconView Kind="{Binding Node.Icon}" Tint="{Binding Node.Color}" Width="16" Height="16" Margin="2,0,8,0"/>
            <TextBlock Text="{Binding Node.Name}" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type vm:MainViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───────── Barre supérieure ───────── -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="268"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Control Template="{StaticResource Logo}" Width="26" Height="26" Focusable="False"/>
                        <TextBlock Text="InfraVault" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="1" MaxWidth="620" HorizontalAlignment="Stretch" Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip="Retour (Alt+←)" Margin="0,0,8,0">
                            <c:IconView Kind="chevron-left" Width="17" Height="17"/>
                        </Button>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="GlobalSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,62,6" Height="36"
                                     Tag="Rechercher un hostname, une IP, un identifiant, un tag…" c:Assist.EnterCommand="{Binding SubmitSearchCommand}"/>
                            <c:IconView Kind="search" Width="16" Height="16" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource TextFaint}" IsHitTestVisible="False"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Padding="6,1" CornerRadius="5"
                                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource TextFaint}" FontFamily="{StaticResource Font.Mono}"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Basculer thème clair / sombre">
                            <Grid>
                                <c:IconView Kind="sun" Visibility="{Binding Theme.IsDark, Converter={StaticResource Vis}}"/>
                                <c:IconView Kind="moon" Visibility="{Binding Theme.IsDark, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                            </Grid>
                        </Button>
                        <Border Width="1" Height="20" Background="{DynamicResource Line}" Margin="8,0"/>
                        <c:IconView Kind="user" Width="15" Height="15" Foreground="{DynamicResource TextFaint}" Margin="4,0,6,0"/>
                        <TextBlock Text="{Binding UserName}" Style="{StaticResource Muted}" VerticalAlignment="Center" MaxWidth="140"/>
                        <Button Margin="12,0,0,0" Command="{Binding LockCommand}" ToolTip="Verrouiller le coffre (Ctrl+L)">
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Kind="lock" Style="{StaticResource BtnIcon}"/>
                                <TextBlock Text="Verrouiller"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────── Navigation et explorateur ───────── -->
            <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding NavEntries}" Margin="10,12,10,6" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavItem}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Key}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:IconView Kind="{Binding Icon}" Width="17" Height="17" Margin="0,0,11,0"/>
                                        <TextBlock Text="{Binding Label}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="1" Margin="20,12,10,6">
                        <TextBlock Text="Explorateur" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" Command="{Binding NewAssetCommand}"
                                ToolTip="Nouvelle ressource (Ctrl+N)">
                            <c:IconView Kind="plus" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <TreeView Grid.Row="2" ItemsSource="{Binding Tree}" ItemTemplate="{StaticResource TreeNodeTemplate}" Margin="8,0,2,8"
                              c:ItemClick.Command="{Binding OpenNodeCommand}"/>
                    <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="20,10,20,0" Visibility="{Binding TreeIsEmpty, Converter={StaticResource Vis}}">
                        <TextBlock Text="L'inventaire est vide." Style="{StaticResource Muted}"/>
                        <TextBlock Text="Ajoutez un datacenter ou un serveur : les ressources que vous y rattacherez apparaîtront ici." Style="{StaticResource Faint}"
                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,10"/>
                        <Button Style="{StaticResource Link}" Content="Ajouter une ressource" Command="{Binding NewAssetCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────── Contenu ───────── -->
            <Grid Grid.Row="1" Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2" Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource Vis}}"/>
            </Grid>

            <!-- ───────── Barre d'état ───────── -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource BgDeep}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,7,0"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}">
                            <Run Text="{Binding VaultName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · déverrouillé"/>
                        </TextBlock>
                        <TextBlock Text="{Binding LockCountdown}" Style="{StaticResource Faint}" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InventoryStatus}" Style="{StaticResource Faint}" Margin="0,0,16,0"/>
                        <c:IconView Kind="alert" Width="13" Height="13" Foreground="{DynamicResource Warning}" Margin="0,0,5,0"
                                    Visibility="{Binding BackupOverdue, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Faint}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
