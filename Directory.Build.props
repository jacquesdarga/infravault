<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>

    <Product>InfraVault</Product>
    <Company>InfraVault</Company>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Versions centralisées des dépendances -->
    <EfCoreVersion>10.0.15</EfCoreVersion>
    <MsExtensionsVersion>10.0.15</MsExtensionsVersion>
    <FluentValidationVersion>12.2.0</FluentValidationVersion>
    <Argon2Version>1.3.1</Argon2Version>
    <SerilogVersion>4.4.0</SerilogVersion>
    <MvvmToolkitVersion>8.4.2</MvvmToolkitVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitRunnerVersion>3.1.5</XunitRunnerVersion>
    <TestSdkVersion>18.12.0</TestSdkVersion>
  </PropertyGroup>
</Project>
